# Gemini API Configuration (Server secret - never expose to browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Execution & Sandbox Configuration
APP_ENV=development
MAX_EXECUTION_TIME_MS=30000
MAX_TRACE_STEPS=2000
MAX_OUTPUT_BYTES=250000

# Vercel Sandbox / microVM Token (Optional if running locally or using Vercel OIDC)
VERCEL_SANDBOX_TOKEN=
